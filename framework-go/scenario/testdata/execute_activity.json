 "views": [
  {
   "useCaseID": "execute-a-project-activity",
   "steps": [
    {
     "nodeID": "pump-fires",
     "calls": [
      {
       "from": "scheduler-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "executeNextActivity(projectId, tickId) — the pump starts a child for every eligible activity",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "activity-eligible",
     "calls": [
      {
       "from": "architect-user",
       "to": "web-client",
       "mode": "sync",
       "label": "opens the activity from the plan",
       "alt": "s1"
      },
      {
       "from": "architect-user",
       "to": "mcp-client",
       "mode": "sync",
       "label": "opens the activity over the MCP surface (R4 cross-surface equivalence)",
       "alt": "s1"
      },
      {
       "from": "web-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "queryActivityView(projectId, activityId)",
       "alt": "s2"
      },
      {
       "from": "mcp-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "queryActivityView(projectId, activityId) — same Manager entry",
       "alt": "s2"
      },
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "readProject → the next ready tasks of the activity's lifecycle DAG",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "next-task",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "readActivityExecution → the ready frontier of the task DAG (predecessors passed, revision n)",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "dispatch-task",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "source-control-access",
       "mode": "sync",
       "label": "getInstallationToken(repo) → RepoCredential; openBranch(repo, activityBranch, cred) → BranchRef",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "agentic-job-access",
       "mode": "sync",
       "label": "submitAgenticJob(command, workerClass, branch, contract, cred) — the task's agentic job",
       "alt": ""
      },
      {
       "from": "agentic-job-access",
       "to": "construction-pipeline-runtime",
       "mode": "sync",
       "label": "dispatch the job onto the venue's pipeline runtime",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "observe-validate",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "agentic-job-access",
       "mode": "sync",
       "label": "observeAgenticJob(handle) → terminal phase + summary",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "artifact-access",
       "mode": "sync",
       "label": "storeConstructionOutput / retrieveConstructionOutput — the produced artifact, staged against the task",
       "alt": ""
      },
      {
       "from": "artifact-access",
       "to": "project-git-repo",
       "mode": "sync",
       "label": "write / read the staged output tree on the activity branch",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "episode-access",
       "mode": "sync",
       "label": "appendEpisode(record) — the terminal agentic episode of this attempt",
       "alt": ""
      },
      {
       "from": "episode-access",
       "to": "project-git-repo",
       "mode": "sync",
       "label": "append the episode record to the project's episode ledger",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "retry-remain",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "intervention-engine",
       "mode": "sync",
       "label": "DecideOnVariance(variance) → {Retry | Escalate | Takeover} — the retry budget is the Engine's, not the Manager's",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "escalate-operator",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "recordOperatorNote(activityId, note) — the escalation is recorded on the activity, not held in a workflow variable",
       "alt": ""
      },
      {
       "from": "operator",
       "to": "web-client",
       "mode": "sync",
       "label": "reads the escalation and steers the activity",
       "alt": "s1"
      },
      {
       "from": "operator",
       "to": "mcp-client",
       "mode": "sync",
       "label": "steers the activity over the MCP surface (R4 cross-surface equivalence)",
       "alt": "s1"
      },
      {
       "from": "web-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "overrideActivity(projectId, activityId, override) — retry | skip | takeover",
       "alt": "s2"
      },
      {
       "from": "mcp-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "overrideActivity(projectId, activityId, override) — same Manager entry",
       "alt": "s2"
      }
     ]
    },
    {
     "nodeID": "operator-intervened",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "readProject → the operator override, if one landed before the escalation window closed",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "propose-reviews",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "source-control-access",
       "mode": "sync",
       "label": "openPullRequest(repo, head=activityBranch, base=main, cred) → PullRequestRef — the reviewable surface",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "review-engine",
       "mode": "sync",
       "label": "ProposeReviews(change, activityType, lifecyclePhase, componentId, policy, floorTouched, contracts) → ReviewSet",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "requires-human",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "review-engine",
       "mode": "sync",
       "label": "the ReviewSet's own seats decide it: a non-overridable floor row always holds for a human",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "dispatch-reviewers",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "agentic-job-access",
       "mode": "sync",
       "label": "submitAgenticJob(review command, reviewer role) per agent seat; observeAgenticJob → each seat's verdict",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "human-decision",
     "calls": [
      {
       "from": "architect-user",
       "to": "web-client",
       "mode": "sync",
       "label": "reads the staged artifact and the agent verdicts; approves or sends back with anchored comments",
       "alt": "s1"
      },
      {
       "from": "architect-user",
       "to": "mcp-client",
       "mode": "sync",
       "label": "decides over the MCP surface (R4 cross-surface equivalence)",
       "alt": "s1"
      },
      {
       "from": "web-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "submitReviewDecision(projectId, activityId, taskId, decision, feedback?)",
       "alt": "s2"
      },
      {
       "from": "mcp-client",
       "to": "delivery-manager",
       "mode": "sync",
       "label": "submitReviewDecision(projectId, activityId, taskId, decision, feedback?) — same Manager entry",
       "alt": "s2"
      }
     ]
    },
    {
     "nodeID": "commit-artifact",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "commitArtifactWithProvenance / commitActivityArtifacts — the staged artifact becomes committed state",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "source-control-access",
       "mode": "sync",
       "label": "postReview(pr, verdict, cred) · mergePullRequest(pr, cred) — the approval is relayed and the branch merges",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "design-health-engine",
       "mode": "sync",
       "label": "EvaluateDesignHealth(project, systemModel) → findings — the gate of a design artifact reads the live Method rules",
       "alt": ""
      }
     ]
    },
    {
     "nodeID": "record-exit",
     "calls": [
      {
       "from": "delivery-manager",
       "to": "project-state-access",
       "mode": "sync",
       "label": "recordActivityOutcome(activityId, binary exit) — the LifecyclePhase is earned, never asserted",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "estimation-engine",
       "mode": "sync",
       "label": "ComputeEarnedValue(exits, committedNetwork) → the earned-value point and the projection",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "operation-estimation-engine",
       "mode": "sync",
       "label": "EstimateOperatingCost(option) → the operating-cost headline of the projectDesign activity's M0 gate (§6)",
       "alt": ""
      },
      {
       "from": "delivery-manager",
       "to": "billing-engine",
       "mode": "sync",
       "label": "PriceConstruction(estimate) → the M0 gate's cost in tokens and dollars (§6)",
       "alt": ""
      }
     ]
    }
   ]
  }
 ],
