# Generated by method-assets scaffold. Included by the app Makefile.
#
# The generators are `tool` directives in go.mod, so their versions are the module
# graph's: running one by version is not an option, because the published generator
# modules carry replace directives and the go command refuses that form.
#
# Deterministic component testing (spec §4.3): the scenario tests are GENERATED
# from the committed per-component test plan in .aiarch/state/project.json by
# the platform's testgen, subject and all (the generated scenariocompose package builds
# every component a scenario drives). An agent writes no test code and no hooks file
# (ARCH-TEST-COMPOSE, enforced by the arch gate's TestFileLayout).
# Paths are module-root-relative — the app module lives at the repo root, and
# -uitests is spelled explicitly because testgen's default resolves one level
# ABOVE -root (it assumes a nested Go module this layout does not have).
#
#   gen-models       — (re)write contract.gen.go + fake/fake.gen.go. CONTRACTS="a b"
#                      names the contracts to generate (a construction task names
#                      its own); with none, every contracted package holding code
#   gen-models-check — drift gate over the same set; a contracted package with no
#                      contract.gen.go is drift
#   gen-null         — conformance scaffolding ONLY (the platform's pipeline and fresh
#                      scaffolds, never an app being built): write null.gen.go into every
#                      non-client contract package and a hooks.go answering every seam of
#                      the generated composition root, so a model with nothing built
#                      compiles and boots. Refuses (exit 2) to replace a hooks.go it did
#                      not write.
#   gen-tests        — (re)write every generated test file: each package's
#                      <stereotype>_scenarios.gen_test.go and null.gen_test.go, and each browser
#                      surface's *.spec.gen.ts with its element inventory and runtime
#   gen-tests-check  — drift gate: fails on a stale generated file, an orphan generated
#                      file, or a hooks file left from an earlier generation (no hooks file
#                      is current: nothing emits one)
#   test-discriminate — the null-subject run (TP-DISCRIMINATE): re-run every Go scenario once per
#                      stimulus operation with that operation nulled (AIARCH_NULL_OPS); a scenario
#                      that still passes would pass without the behavior it claims to test, and is
#                      printed as `TP-DISCRIMINATE <component> <scenario> <op>` (exit 1). Run it on
#                      a tree gen-tests-check has just passed. Machine-client scenarios null the
#                      Manager operation a call reaches in the app the test launches; web scenarios
#                      run through the scenario host (`go tool webscenarios`) with the Manager
#                      operation their step drives nulled in the server it launches.
#   surface-check    — for each browser surface, run its generated surface.spec.gen.ts alone
#                      (the `surface` Playwright project): every non-repeating element of the
#                      surface's UI design must be on its screen by the role and accessible
#                      name the design gives it. The scenario flows depend on it. Needs
#                      `npm ci` and the Playwright browser in uitests/; a tree with no browser
#                      surface has nothing to check. Both web targets run under the scenario
#                      host (`go tool webscenarios`), which boots the composed app into the
#                      host's substrates, serves the arrange endpoint and tears everything down
#                      itself: Playwright's own webServer would SIGKILL the app and leak its
#                      Postgres container.
#   test-web         — run every browser surface's generated scenarios (the `scenarios` Playwright
#                      project, after the surface check it depends on) under the scenario host.
#   test-scenarios   — run every TestScenario_* as a `go test -json` stream into
#                      test-results/go-test.jsonl (the venue uploads test-results/**)
#   run-local        — the app's local run contract: an alias of `go run ./cmd/devstack`,
#                      the launcher appgen compose generates from the deployment model. It
#                      provisions the local profile's infrastructure, boots cmd/server and
#                      prints {"devstack":"ready","url":...} once /readyz answers. All its
#                      logic lives in the launcher, so there is exactly one run contract.
.PHONY: gen-models gen-models-check gen-null gen-tests gen-tests-check test-scenarios test-discriminate surface-check test-web run-local

MODELGEN_ARGS = -project .aiarch/state/project.json -root . $(foreach c,$(CONTRACTS),-contract $(c))
TESTGEN_ARGS = -project .aiarch/state/project.json -root . -uitests uitests/generated

gen-models:
	GOWORK=off go tool modelgen $(MODELGEN_ARGS)

gen-models-check:
	GOWORK=off go tool modelgen $(MODELGEN_ARGS) -check

gen-null:
	GOWORK=off go tool nullgen -project .aiarch/state/project.json -root .

gen-tests:
	GOWORK=off go tool testgen $(TESTGEN_ARGS)

gen-tests-check:
	GOWORK=off go tool testgen $(TESTGEN_ARGS) -check

test-scenarios:
	mkdir -p test-results
	GOWORK=off go test ./internal/... -run 'TestScenario_' -json 2>&1 | tee test-results/go-test.jsonl

test-discriminate:
	GOWORK=off go tool testgen $(TESTGEN_ARGS) -discriminate

surface-check:
	@found=0; for cfg in uitests/generated/*/playwright.config.gen.ts; do \
		[ -e "$$cfg" ] || continue; found=1; \
		GOWORK=off go tool webscenarios -C uitests -config "$${cfg#uitests/}" -project surface || exit 1; \
	done; [ "$$found" = 1 ] || echo "surface-check: no browser surface to check"

test-web:
	@found=0; for cfg in uitests/generated/*/playwright.config.gen.ts; do \
		[ -e "$$cfg" ] || continue; found=1; \
		GOWORK=off go tool webscenarios -C uitests -config "$${cfg#uitests/}" -project scenarios || exit 1; \
	done; [ "$$found" = 1 ] || echo "test-web: no browser surface to run"

run-local:
	GOWORK=off go run ./cmd/devstack
