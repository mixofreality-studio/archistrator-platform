// Code generated by archistrator at project birth. DO NOT EDIT.
//
// This is the Method gate every app built with archistrator runs, from the same place
// and with the same argv. arch.MethodSpec derives the layer model from go.mod, so there
// is no prefix to get wrong and nothing for an app to configure:
//
//   - TestFileLayout: every package follows the file naming convention;
//   - TestGeneratedOnlyPublic: only the generated contract is exported;
//   - TestMethodLayering: downward-only imports, Temporal isolation, interface naming,
//     the dependency menu, no hand-duplicated contract, and a go.mod every clone resolves;
//   - TestMethod: the committed design rules, and design-to-code alignment.
//
// A package outside the layer directories fails these, including when it is the only
// code in the tree: the gate never passes by having found nothing to classify.
package internal_test

import (
	"testing"

	"github.com/mixofreality-studio/archistrator-platform/framework-go/arch"
	"github.com/mixofreality-studio/archistrator-platform/framework-go/methodcheck"
)

// moduleRoot is the app's Go module, relative to this package.
const moduleRoot = ".."

func TestFileLayout(t *testing.T) {
	arch.CheckFileLayout(t, arch.MethodSpec(moduleRoot))
}

func TestGeneratedOnlyPublic(t *testing.T) {
	arch.CheckGeneratedSurface(t, arch.MethodSpec(moduleRoot), nil)
}

func TestMethodLayering(t *testing.T) {
	spec := arch.MethodSpec(moduleRoot)
	arch.Check(t, spec)
	arch.CheckContractDuplication(t, spec)
	arch.CheckModuleFile(t, moduleRoot)
}

func TestMethod(t *testing.T) {
	methodcheck.Check(t, methodcheck.ProjectSpec{
		RepoRoot: moduleRoot,
		Arch:     arch.MethodSpec(moduleRoot),
	})
}
