		return v
	}
	return def
}

// getenvBool parses a bool; an unparseable env falls back to def.
func getenvBool(name, def string) bool {
	if v := getenv(name); v != "" {
		if x, err := strconv.ParseBool(v); err == nil {
			return x
		}
	}
	x, _ := strconv.ParseBool(def)
	return x
}

// getenvInt parses an int; an unparseable env falls back to def.
func getenvInt(name, def string) int {
	if v := getenv(name); v != "" {
		if x, err := strconv.Atoi(v); err == nil {
			return x
		}
	}
	x, _ := strconv.Atoi(def)
	return x
}

// getenvDuration parses a duration; an unparseable env falls back to def.
func getenvDuration(name, def string) time.Duration {
	if v := getenv(name); v != "" {
		if x, err := time.ParseDuration(v); err == nil {
			return x
		}
	}
	x, _ := time.ParseDuration(def)
	return x
}
